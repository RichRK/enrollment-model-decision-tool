---
// Reads the pipeline's two outputs off disk at build time and inlines what the
// page needs as JSON, so there is no runtime fetch. regions.json supplies the
// DHS rates by region and wealth fifth; squares.json supplies the wealth squares
// and their populations. Every figure in the prose below is derived here.
import fs from "node:fs";
import path from "node:path";
import "../styles/styles.css";
import type { PageData, Basis } from "../scripts/data";

const read = (name: string) =>
  JSON.parse(fs.readFileSync(path.resolve(process.cwd(), "../pipeline/data", name), "utf-8"));
const regionsFile = read("regions.json");
const squaresFile = read("squares.json");

const BASES: Basis[] = ["hh_mobile_phone", "phone_own"];
// DHS's own page for each survey, which the API does not return.
const DHS_SURVEY_PAGES: Record<string, number> = { MD2021DHS: 560 };

type Cell = { value: number | null; suppressed: boolean; merged?: string[] };
const cellsOf = (region: any, basis: Basis): Cell[] =>
  region.quintiles?.[basis]?.ownership_by_quintile ?? [];

const surveyYear: number = regionsFile.sources.dhs.survey_year;
const surveyId: string = regionsFile.sources.dhs.survey_id;
const country: string = regionsFile.country;
const popYear: number = squaresFile.sources.worldpop.year;

if (JSON.stringify(squaresFile.regions) !== JSON.stringify(regionsFile.regions.map((r: any) => r.region_id))) {
  throw new Error("squares.json and regions.json list different regions -- rerun the pipeline");
}

// Region outlines in zoom-level tile units, the same space the squares sit in.
const n = 2 ** squaresFile.tile_zoom;
const project = ([lon, lat]: number[]) => {
  const r = (lat * Math.PI) / 180;
  const y = ((1 - Math.log(Math.tan(r) + 1 / Math.cos(r)) / Math.PI) / 2) * n;
  return [Math.round(((lon + 180) / 360) * n * 10) / 10, Math.round(y * 10) / 10];
};
const outlines = regionsFile.regions.map((r: any) => {
  const g = r.geometry;
  const polys = g.type === "Polygon" ? [g.coordinates] : g.coordinates;
  return polys.map((poly: number[][][]) => poly.map((ring) => ring.map(project)));
});

const col = (k: number) => squaresFile.squares.map((s: number[]) => s[k]);
const data: PageData = {
  survey_year: surveyYear,
  names: regionsFile.regions.map((r: any) => r.name),
  outlines,
  rates: Object.fromEntries(BASES.map((b) => [b, regionsFile.regions.map((r: any) =>
    cellsOf(r, b).map((c) => (c.suppressed || c.value === null ? null : Math.round(c.value * 10) / 10)))])) as PageData["rates"],
  tx: col(0), ty: col(1), region: col(4), pop: col(5), fifth: col(6),
};
const inlineJson = JSON.stringify(data).replace(/<\/script/gi, "<\\/script");

// Figures quoted in the two dialogs.
const covered = data.pop.reduce((a, b) => a + b, 0);
const uncovered = squaresFile.pop_total - covered;
const outside = data.pop.reduce((a, p, i) => a + (data.region[i] < 0 ? p : 0), 0);
const gaps = squaresFile.wealth_check.map((c: any) => c.gap).sort((a: number, b: number) => a - b);
const medianGap = gaps.length ? Math.round(gaps[gaps.length >> 1] * 100) + "%" : "—";
const mergedRegions = regionsFile.regions.filter((r: any) =>
  BASES.some((b) => cellsOf(r, b).some((c) => c.merged))).length;
const WORDS = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
const word = (k: number) => WORDS[k] ?? String(k);
const surveyPage = DHS_SURVEY_PAGES[surveyId];
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{country} Remote Enrollment</title>
</head>
<body>
<div class="wrap">
  <div class="left">
    <div>
      <h1>Who in {country} could enroll by phone?</h1>
      <p class="lede">Every included area receives one visit to build trust. People who are able to enroll by phone do so; everyone else enrolls in person during that visit.</p>
    </div>

    <div class="answer">
      <div class="slider" id="sliderBox">
        <span class="top"><span class="lab">Wealth slider
          <span class="info"><button type="button" aria-label="How people are ranked" aria-expanded="false">i</button>
            <span class="pop" role="tooltip">{country} is split into small areas, each scored from poorest to richest. The slider starts with the poorest areas and adds richer ones until it covers the share of people you pick. Everyone in an area gets that area's score.</span>
          </span>
        </span><span class="cnt" id="cnt"></span></span>
        <span class="row"><input id="pct" type="range" min="5" max="100" step="5" value="100" aria-label="Share of people to include, poorest first"><output id="pctOut">Everyone</output></span>
      </div>
      <div class="selbar" id="selbar" hidden><span id="selName"></span></div>
      <div class="chips" id="big"></div>
      <div class="stack" id="stack" aria-hidden="true"></div>
      <div class="set">Show as
        <span class="unit" id="unitSeg" role="group" aria-label="Show as"><button type="button" data-u="pc" aria-pressed="true">Percentages</button><button type="button" data-u="n" aria-pressed="false">Numbers</button></span></div>
    </div>

    <div class="settings" id="settings">
      <div class="set">Phone owners enroll household members
        <span class="unit" id="hhSeg" role="group" aria-label="Phone owners enroll household members"><button type="button" data-b="hh_mobile_phone" aria-pressed="false">Yes</button><button type="button" data-b="phone_own" aria-pressed="true">No</button></span>
        <span class="info"><button type="button" aria-label="About household members" aria-expanded="false">i</button><span class="pop" role="tooltip">Yes: everyone in a household with a phone counts as reachable, using the survey's household phone ownership. No: only people who own a phone themselves count. This uses the survey's own-phone rate for women and men aged 15–49, pooled and counted equally.</span></span></div>
      <div class="set">Phone owners also enroll
        <span class="kgrp"><span class="unit" id="kSeg" role="group" aria-label="People without a phone each owner also enrolls"><button type="button" data-k="0" aria-pressed="true">0</button><button type="button" data-k="1" aria-pressed="false">1</button><button type="button" data-k="2" aria-pressed="false">2</button></span>others
          <span class="info"><button type="button" aria-label="About phone sharing" aria-expanded="false">i</button><span class="pop" role="tooltip">Adds people without a phone who enroll using someone else's handset, such as a neighbour or relative. The survey doesn't say how often this happens.</span></span></span></div>
    </div>

    <div class="links">
      <button type="button" class="methodsBtn" data-dialog="methods" aria-haspopup="dialog">How are these calculations made?</button>
      <button type="button" class="methodsBtn" data-dialog="limits" aria-haspopup="dialog">What limitations exist?</button>
    </div>
    <p class="credit">Data: The DHS Program, {country} DHS {surveyYear}; Relative Wealth Index, Data for Good at Meta; WorldPop {popYear}.</p>

    <dialog id="methods" aria-labelledby="methodsTitle">
      <button type="button" class="close" aria-label="Close">×</button>
      <h2 id="methodsTitle">How are these calculations made?</h2>
      <p><b>One score per square.</b> Each 2.4&nbsp;km square gets the share of its households that own a mobile phone, taken from the DHS {surveyYear} survey for its region and wealth fifth. With household members switched off, it uses the share of adults aged 15–49 who own a phone themselves instead, with women and men pooled and counted equally. Meta's Relative Wealth Index decides which wealth fifth a square belongs to. WorldPop's {popYear} estimates give the number of people, which turns shares into totals.</p>
      <p><b>Phone sharing.</b> "Phone owners also enroll" lets each phone owner also enroll 0–2 people without a phone, such as a neighbour or relative using their handset. It multiplies each square's phone share by one plus that number, capped at everyone in the square. The survey says nothing about how often this happens.</p>
      <p><b>Why "at most".</b> Access to a phone is necessary for remote enrollment but not enough on its own. Literacy, an ID for the SIM, trust and signal coverage all reduce the number further, and none of them is included here. Phone ownership has also probably risen since {surveyYear}.</p>
      <p><b>Why a range.</b> The wealth index and the survey disagree about who is poor: in the median region, {medianGap} of people fall in a different wealth fifth. The upper figure uses the next-richer fifth's phone rate for each square.</p>
      <p><b>Neighbouring squares often share a score.</b> The survey reports phone ownership only by region and wealth fifth, so the scores take at most {data.names.length * 5} values. The map shows where each value applies, not variation within a region.</p>
      <p><b>Merged fifths.</b> Where a region has fewer than 25 survey cases in one wealth fifth, that fifth is published together with a neighbouring fifth as one figure, so its own rate can't be worked out from the region's total. This happens in {word(mergedRegions)} regions, and the shared figure leans towards the better-sampled fifth.</p>
      <p>Sources: <a href="https://ai.meta.com/ai-for-good/datasets/relative-wealth-index/" target="_blank" rel="noopener">Relative Wealth Index</a>, Data for Good at Meta (CC BY-NC 4.0; <a href="https://doi.org/10.1073/pnas.2113658119" target="_blank" rel="noopener">Chi et al., PNAS 2022</a>). <a href="https://hub.worldpop.org/" target="_blank" rel="noopener">WorldPop</a> {popYear} constrained population. The DHS Program, {surveyPage
        ? <a href={`https://dhsprogram.com/methodology/survey/survey-display-${surveyPage}.cfm`} target="_blank" rel="noopener">{country} DHS {surveyYear}</a>
        : <>{country} DHS {surveyYear}</>}.</p>
    </dialog>
    <dialog id="limits" aria-labelledby="limitsTitle">
      <button type="button" class="close" aria-label="Close">×</button>
      <h2 id="limitsTitle">What limitations exist?</h2>
      <p><b>Blank areas on the map.</b> Squares appear only where Meta's Relative Wealth Index gives a score, and Meta scored only the squares it treated as populated. WorldPop counts about {Math.round((uncovered / squaresFile.pop_total) * 100)}% of {country}'s people ({(uncovered / 1e6).toFixed(1)}M) living in the blank areas, mostly in thinly settled countryside. They are left out of every figure here, and they may be among the hardest people to reach.</p>
      <p><b>Squares outside the survey regions.</b> A few coastal squares ({(Math.round(outside / 10) * 10).toLocaleString("en")} people) fall outside every DHS region's boundary, so they have no survey figure and show in grey.</p>
    </dialog>
  </div>

  <div class="mapcol">
    <div class="mapbox" id="mapbox">
      <canvas id="map" aria-label="Map of the share of people in each square who could enroll by phone"></canvas>
      <div class="zoom">
        <button id="zin" aria-label="Zoom in">+</button>
        <button id="zout" aria-label="Zoom out">&minus;</button>
        <button id="zfit" aria-label="Reset view" style="font-size:12px">&#8634;</button>
      </div>
      <div class="tip" id="tip" hidden></div>
    </div>
    <div class="legend" id="legend"></div>
  </div>
</div>

<script type="application/json" id="page-data" set:html={inlineJson}></script>
<script src="../scripts/app.ts"></script>
</body>
</html>
