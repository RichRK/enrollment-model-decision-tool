---
// Reads pipeline/data/regions.json off disk at build time -- the pipeline's
// output is the single source of truth, and this file is never copied or
// duplicated. Inlined into the page as JSON below rather than fetched at
// runtime, so there's no "must be served over HTTP" failure mode left: the data
// is part of the HTML response.
import fs from "node:fs";
import path from "node:path";
import "../styles/styles.css";

import Masthead from "../components/Masthead.astro";
import Scenario from "../components/Scenario.astro";
import GradientSection from "../components/GradientSection.astro";
import MapColumn from "../components/MapColumn.astro";
import RegionDrawer from "../components/RegionDrawer.astro";
import Notes from "../components/Notes.astro";
import SourcesFooter from "../components/SourcesFooter.astro";
import type { Data, Region } from "../scripts/state";

const regionsPath = path.resolve(process.cwd(), "../pipeline/data/regions.json");
const regionsJson = fs.readFileSync(regionsPath, "utf-8");
// Defensive escaping in case a future field ever contains a literal "</script>"
// sequence -- it would otherwise close the tag early and truncate the data.
const inlineSafeJson = regionsJson.replace(/<\/script/gi, "<\\/script");

/* Every figure quoted in the prose below is derived here, from the same file the
 * page ships. None of them is typed by hand.
 *
 * This is not stylistic. The page's whole argument is that a number should never
 * be substituted, imputed or assumed -- and it used to assert six figures in its
 * own copy that the pipeline recomputes on every run. They were all correct, which
 * is exactly the problem: nothing would have told anyone when they stopped being.
 * The worst pair were four paragraphs apart and disagreed by construction, one
 * hardcoded ("Four regions have no answer") and one computed by the script from
 * the same data. */
const data = JSON.parse(regionsJson) as Data;
const surveyYear = data.sources.dhs.survey_year;
const headline = data.constants.headline_indicator;

const gradientOf = (region: Region) => (region.quintiles || {})[headline] || null;

// The cost inputs' starting values. Placeholders, stated once here and bound into
// the two fields, because the worked example below has to be chosen against the
// same line they imply -- otherwise the page could name a region as one that
// "would clear the line" while its own defaults shade it the other way.
const defaultCostRemote = 1;
const defaultCostInPerson = 2;
const defaultLine = defaultCostRemote / defaultCostInPerson;

// The worked example in "Read the map second": of the regions that clear the
// default cost line on average -- so the sentence's "would often clear the line"
// is true of it -- the one with the worst targeting distortion. Picked by the
// data, not from memory.
const worked = data.regions
  .filter((region) => region[headline as "hh_mobile_phone"] !== null &&
    (region[headline as "hh_mobile_phone"] as number) / 100 >= defaultLine &&
    (gradientOf(region)?.targeting_distortion ?? null) !== null)
  .sort((a, b) => (gradientOf(a)!.targeting_distortion as number) -
    (gradientOf(b)!.targeting_distortion as number))[0];
const workedDistortion = gradientOf(worked)!.targeting_distortion as number;
const workedRate = worked[headline as "hh_mobile_phone"] as number;
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Remote enrollment vs. in-person registration &mdash; {data.country} by region</title>
</head>
<body>

<Masthead country={data.country} surveyYear={surveyYear} regionCount={data.regions.length} />

<main>

<noscript>
  <section class="panel warn">
    <h2>This page needs JavaScript</h2>
    <p>
      The recommendation recomputes as you change the cost inputs, which is the point of
      the tool, so the values are calculated in the browser rather than baked in. The
      notes below are readable without it. The underlying data is a single file:
      <code>pipeline/data/regions.json</code>.
    </p>
  </section>
</noscript>

<div data-bind="load-error" class="panel warn" hidden>
  <h2>Could not load the region data</h2>
  <p>
    The data this page needs is normally embedded in it at build time, so this means the
    build itself is stale or broken rather than a network problem. Run <code>make build</code>
    (or <code>uv run python pipeline/run_all.py</code>) from the repository root, then
    rebuild the site with <code>bun run build</code> in <code>site/</code>.
  </p>
</div>

<!-- Left column scrolls, right column stays pinned. The sticky map releases
     naturally where .article ends, which is above the notes. -->
<div class="article" data-bind="app" hidden>
  <!-- data-bind="copy" so focus.ts can make the pane inert while it is faded
       out; see setMapFocus(). -->
  <div class="copy" data-bind="copy">
    <Scenario costRemote={defaultCostRemote} costInPerson={defaultCostInPerson} />

    <GradientSection />

    <section class="read-second">
      <h2>Read the map second</h2>
      <p>
        The map shades each region by <em>average</em> &mdash; and the average is not the
        decision. A region shaded for remote enrollment may still exclude nearly all of its
        poorest households: {worked.name} averages {workedRate.toFixed(1)}% household phone
        ownership and would often clear the line, yet its targeting distortion is
        {" "}{workedDistortion.toFixed(2)}.
      </p>
      <p>
        The <strong>Who it excludes</strong> layer shows that directly, and
        <strong>Compare</strong> puts the two side by side: the regions to worry about are
        the ones shaded for remote on the left but pale on the right. Any region&rsquo;s
        drawer puts its targeting distortion above everything the cost model says.
      </p>
    </section>
  </div>

  <MapColumn surveyYear={surveyYear} regionCount={data.regions.length} />
</div>

<RegionDrawer />

<Notes data={data} />

</main>

<SourcesFooter data={data} />

<script type="application/json" id="regions-data" set:html={inlineSafeJson}></script>
<script src="../scripts/app.ts"></script>
</body>
</html>
